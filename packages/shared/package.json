{
  "name": "@agentlensjs/shared",
  "version": "0.5.1",
  "description": "Shared event protocol and type definitions for AgentLens packages.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YoungDan-hero/agentlens.git",
    "directory": "packages/shared"
  },
  "keywords": [
    "agentlens",
    "mcp",
    "ai-agent",
    "devtools"
  ],
  "publishConfig": {
    "access": "public"
  }
}
